# ==========================================================
# LOCAL CONFIGURATION
# ==========================================================

CSV_PATH=data/sales_data.csv

REPORT_DIR=reports

CLEANED_CSV_PATH=data/cleaned_sales_data.csv

# ==========================================================
# AZURE SQL DATABASE
# ==========================================================

READ_FROM_AZURE_SQL=false

AZURE_SQL_SERVER=your_server.database.windows.net

AZURE_SQL_DATABASE=your_database

AZURE_SQL_USERNAME=your_username

AZURE_SQL_PASSWORD=your_password

AZURE_SQL_TABLE=SalesData

AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# ==========================================================
# AZURE BLOB STORAGE
# ==========================================================

UPLOAD_TO_AZURE=true

AZURE_STORAGE_CONNECTION_STRING=your_connection_string

AZURE_CONTAINER_NAME=input

AZURE_BLOB_NAME=cleaned_sales_data.csv

# ==========================================================
# EMAIL CONFIGURATION
# ==========================================================

SEND_EMAIL=true

SMTP_SERVER=smtp.gmail.com

SMTP_PORT=587

SMTP_USER=your_email@gmail.com

SMTP_PASS=your_app_password

TO_ADDRESS=receiver@gmail.com

EMAIL_SUBJECT=Azure ETL Pipeline Report

# ==========================================================
# PIPELINE CONFIGURATION
# ==========================================================

RETRY_COUNT=3

RETRY_DELAY=5